{
  "name": "erdemcut",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "desktop:bundle": "node electron/build.mjs",
    "desktop:dev": "npm run build && npm run desktop:bundle && electron .",
    "desktop:dist": "npm run build && npm run desktop:bundle && electron-builder --publish never"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "@huggingface/transformers": "4.3.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "mediabunny": "^1.66.0",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "zustand": "^5.1.0"
  },
  "allowScripts": {
    "electron@45.4.1": true,
    "ffmpeg-static@5.3.0": true,
    "esbuild@0.28.2": true
  },
  "main": "dist-electron/main.mjs",
  "description": "ErdemCut - browser/desktop video editor",
  "author": "EDMGL"
}
